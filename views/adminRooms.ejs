<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('partials/head'); %>
		<title>Rooms | Admin | Loydon Resort</title>
		<link rel="stylesheet" href="/css/general.css" />
	</head>
	<body class="bg-bg">
		<%- include('partials/nav'); %>

		<div class="max-w-5xl mx-auto mt-8 px-4 mb-20">
			<div class="flex items-center gap-4 mb-6 flex-wrap">
				<a href="/admin" class="text-gray-600 hover:text-hotel">← Admin</a>
				<h1 class="text-4xl font-bold text-hotel">Rooms</h1>
				<form method="post" action="/admin/logout" class="ml-auto inline">
					<button type="submit" class="text-gray-500 hover:text-red-600 text-sm">Log out</button>
				</form>
			</div>

			<!-- Add / Edit form -->
			<div id="formSection" class="bg-white p-6 rounded-xl shadow-md mb-8 hidden">
				<h2 id="formTitle" class="text-xl font-semibold text-hotel mb-4">Add room</h2>
				<form id="roomForm" class="space-y-4">
					<input type="hidden" id="roomId" name="id" />
					<div>
						<label for="room_number" class="block text-sm font-medium text-gray-700 mb-1">Room number *</label>
						<input type="number" id="room_number" name="room_number" required min="1" class="w-full border border-gray-300 rounded-lg p-2" placeholder="201" />
					</div>
					<div>
						<label for="room_category_id" class="block text-sm font-medium text-gray-700 mb-1">Category *</label>
						<select id="room_category_id" name="room_category_id" required class="w-full border border-gray-300 rounded-lg p-2">
							<option value="">Select category</option>
						</select>
					</div>
					<div>
						<label for="floor" class="block text-sm font-medium text-gray-700 mb-1">Floor</label>
						<input type="number" id="floor" name="floor" min="0" class="w-full border border-gray-300 rounded-lg p-2" placeholder="2" />
					</div>
					<div>
						<label for="room_image" class="block text-sm font-medium text-gray-700 mb-1">Room image</label>
						<input type="file" id="room_image" name="image" accept="image/*" class="w-full border border-gray-300 rounded-lg p-2 bg-white" />
						<p class="text-xs text-gray-500 mt-1">
							Optional photo used when this specific room is shown.
						</p>
					</div>
					<div id="isActiveRow" class="hidden">
						<label class="inline-flex items-center gap-2">
							<input type="checkbox" id="is_active" name="is_active" checked class="rounded" />
							<span class="text-sm font-medium text-gray-700">Active (available for booking)</span>
						</label>
					</div>
					<div class="flex gap-2">
						<button type="submit" class="btn">Save</button>
						<button type="button" id="cancelForm" class="btn bg-gray-500 hover:bg-gray-600">Cancel</button>
					</div>
				</form>
			</div>

			<div class="flex justify-between items-center mb-4">
				<p class="text-gray-600">Manage room numbers and categories</p>
				<button type="button" id="addRoomBtn" class="btn">Add room</button>
			</div>

			<div class="bg-white rounded-xl shadow-lg overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full text-left">
						<thead class="bg-gray-50 border-b border-gray-200">
							<tr>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Room #</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Category</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Floor</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Status</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Actions</th>
							</tr>
						</thead>
						<tbody id="roomsTable" class="divide-y divide-gray-200">
							<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">Loading…</td></tr>
						</tbody>
					</table>
				</div>
			</div>
			<p id="errorMessage" class="mt-4 text-red-600 hidden"></p>
		</div>

		<%- include('partials/footer'); %>
		<script>
			let categories = [];
			const formSection = document.getElementById("formSection");
			const formTitle = document.getElementById("formTitle");
			const roomForm = document.getElementById("roomForm");
			const roomId = document.getElementById("roomId");
			const categorySelect = document.getElementById("room_category_id");
			const isActiveRow = document.getElementById("isActiveRow");
			const addRoomBtn = document.getElementById("addRoomBtn");
			const cancelForm = document.getElementById("cancelForm");
			const roomsTable = document.getElementById("roomsTable");
			const errorMessage = document.getElementById("errorMessage");

			function showError(msg) {
				errorMessage.textContent = msg;
				errorMessage.classList.remove("hidden");
			}
			function clearError() {
				errorMessage.classList.add("hidden");
			}

			function escapeHtml(s) {
				if (!s) return "";
				const div = document.createElement("div");
				div.textContent = s;
				return div.innerHTML;
			}

			async function loadCategories() {
				const res = await fetch("/api/categories");
				const data = await res.json();
				if (!res.ok) throw new Error(data.error || "Failed to load categories");
				categories = data.categories;
				const options = categorySelect.querySelectorAll("option");
				for (let i = 1; i < options.length; i++) options[i].remove();
				categories.forEach(c => {
					const opt = document.createElement("option");
					opt.value = c.id;
					opt.textContent = c.name;
					categorySelect.appendChild(opt);
				});
			}

			async function loadRooms() {
				const res = await fetch("/api/rooms");
				const data = await res.json();
				if (!res.ok) throw new Error(data.error || "Failed to load rooms");
				const list = data.rooms;
				if (list.length === 0) {
					roomsTable.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No rooms yet. Click Add room.</td></tr>';
					return;
				}
				roomsTable.innerHTML = list.map(r => `
					<tr class="hover:bg-gray-50">
						<td class="px-6 py-4 font-semibold text-hotel">${r.room_number}</td>
						<td class="px-6 py-4 text-gray-700">${escapeHtml(r.category_name)}</td>
						<td class="px-6 py-4 text-gray-700">${r.floor != null ? r.floor : "—"}</td>
						<td class="px-6 py-4">
							${r.is_active ? '<span class="text-green-600 font-medium">Active</span>' : '<span class="text-gray-500">Inactive</span>'}
						</td>
						<td class="px-6 py-4">
							<button type="button" class="edit-room text-hotel hover:underline mr-3" data-id="${r.id}">Edit</button>
							<button type="button" class="delete-room text-red-600 hover:underline" data-id="${r.id}" data-number="${r.room_number}">Delete</button>
						</td>
					</tr>
				`).join("");
				roomsTable.querySelectorAll(".edit-room").forEach(btn => btn.addEventListener("click", () => openEdit(btn.dataset.id)));
				roomsTable.querySelectorAll(".delete-room").forEach(btn => btn.addEventListener("click", () => confirmDelete(btn.dataset.id, btn.dataset.number)));
			}

			function openAdd() {
				clearError();
				roomId.value = "";
				formTitle.textContent = "Add room";
				document.getElementById("room_number").value = "";
				document.getElementById("room_category_id").value = categories[0] ? categories[0].id : "";
				document.getElementById("floor").value = "";
				const imageInput = document.getElementById("room_image");
				if (imageInput) imageInput.value = "";
				isActiveRow.classList.add("hidden");
				formSection.classList.remove("hidden");
			}

			async function openEdit(id) {
				clearError();
				const res = await fetch("/api/rooms/" + id);
				const data = await res.json();
				if (!res.ok) throw new Error(data.error || "Failed to load room");
				const r = data.room;
				roomId.value = r.id;
				formTitle.textContent = "Edit room";
				document.getElementById("room_number").value = r.room_number;
				document.getElementById("room_category_id").value = r.room_category_id;
				document.getElementById("floor").value = r.floor != null ? r.floor : "";
				const imageInput = document.getElementById("room_image");
				if (imageInput) imageInput.value = "";
				document.getElementById("is_active").checked = r.is_active !== false;
				isActiveRow.classList.remove("hidden");
				formSection.classList.remove("hidden");
			}

			function closeForm() {
				formSection.classList.add("hidden");
			}

			roomForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				clearError();
				const id = roomId.value;
				const formData = new FormData();
				formData.append("room_number", document.getElementById("room_number").value);
				formData.append("room_category_id", document.getElementById("room_category_id").value);
				formData.append("floor", document.getElementById("floor").value);
				if (id) {
					formData.append("is_active", String(document.getElementById("is_active").checked));
				}
				const imageInput = document.getElementById("room_image");
				if (imageInput && imageInput.files[0]) {
					formData.append("image", imageInput.files[0]);
				}

				const url = id ? "/api/rooms/" + id : "/api/rooms";
				const method = id ? "PUT" : "POST";
				const res = await fetch(url, { method, body: formData });
				const data = await res.json();
				if (!res.ok) {
					showError(data.error || "Request failed");
					return;
				}
				closeForm();
				loadRooms();
			});

			async function confirmDelete(id, number) {
				if (!confirm(`Delete room ${number}? This cannot be undone.`)) return;
				clearError();
				const res = await fetch("/api/rooms/" + id, { method: "DELETE" });
				const data = await res.json();
				if (!res.ok) {
					showError(data.error || "Delete failed");
					return;
				}
				loadRooms();
			}

			addRoomBtn.addEventListener("click", openAdd);
			cancelForm.addEventListener("click", closeForm);

			(async () => {
				await loadCategories();
				await loadRooms();
			})();
		</script>
	</body>
</html>
