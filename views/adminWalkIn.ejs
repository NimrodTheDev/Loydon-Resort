<!DOCTYPE html>
<html lang="en">

<head>
	<%- include('partials/head'); %>
		<title>Walk-in Booking | Admin | Loydon Resort</title>
		<link rel="stylesheet" href="/css/general.css" />
</head>

<body class="bg-bg">
	<%- include('partials/nav'); %>

		<div class="max-w-4xl mx-auto mt-8 px-4 mb-20">
			<div class="flex items-center gap-4 mb-6">
				<a href="/admin" class="text-gray-600 hover:text-hotel">← Admin Dashboard</a>
				<h1 class="text-4xl font-bold text-hotel">Walk-in Booking</h1>
			</div>

			<div class="bg-white p-8 rounded-xl shadow-lg border border-gray-200">
				<form id="walkInForm" class="space-y-6">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<!-- Guest Info -->
						<div class="space-y-4">
							<h2 class="text-xl font-semibold text-hotel border-b pb-2">Guest Information</h2>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
								<input type="text" name="guestName" required class="w-full border border-gray-300 rounded-lg p-3" placeholder="John Doe" />
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Email Address *</label>
								<input type="email" name="guestEmail" required class="w-full border border-gray-300 rounded-lg p-3" placeholder="john@example.com" />
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
								<input type="tel" name="guestPhone" class="w-full border border-gray-300 rounded-lg p-3" placeholder="+234..." />
							</div>
						</div>

						<!-- Booking Details -->
						<div class="space-y-4">
							<h2 class="text-xl font-semibold text-hotel border-b pb-2">Stay Details</h2>
							<div class="grid grid-cols-2 gap-4">
								<div>
									<label class="block text-sm font-medium text-gray-700 mb-1">Check-in *</label>
									<input type="date" id="checkInDate" name="checkInDate" required class="w-full border border-gray-300 rounded-lg p-3" />
								</div>
								<div>
									<label class="block text-sm font-medium text-gray-700 mb-1">Check-out *</label>
									<input type="date" id="checkOutDate" name="checkOutDate" required class="w-full border border-gray-300 rounded-lg p-3" />
								</div>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Room Category *</label>
								<select id="categorySelect" name="categoryId" required class="w-full border border-gray-300 rounded-lg p-3">
									<option value="">Select a category</option>
									<% categories.forEach(c => { %>
										<option value="<%= c.id %>" data-price="<%= c.price %>"><%= c.name %> (₦<%= c.price.toLocaleString() %>/night)</option>
									<% }) %>
								</select>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Select Room(s) *</label>
								<select id="roomSelect" name="roomIds" multiple required class="w-full border border-gray-300 rounded-lg p-3 h-32">
									<option value="" disabled>Select category first</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Payment Section -->
					<div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
						<h2 class="text-xl font-semibold text-hotel mb-4">Payment & Confirmation</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-end">
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Payment Method *</label>
								<select name="paymentMethod" required class="w-full border border-gray-300 rounded-lg p-3">
									<option value="cash">Cash</option>
									<option value="transfer">Bank Transfer</option>
									<option value="pos">POS</option>
									<option value="complimentary">Complimentary</option>
								</select>
							</div>
							<div class="text-right">
								<div id="totalDisplay" class="text-2xl font-bold text-hotel mb-2">Total: ₦0</div>
								<button type="submit" class="btn w-full md:w-auto px-8 py-3 bg-hotel hover:bg-opacity-90 text-white font-bold rounded-lg shadow-md transition-all">
									Confirm Walk-in Booking
								</button>
							</div>
						</div>
					</div>
				</form>
				<p id="message" class="mt-4 p-3 rounded-lg hidden"></p>
			</div>
		</div>

		<%- include('partials/footer'); %>

		<script>
			const checkInInput = document.getElementById("checkInDate");
			const checkOutInput = document.getElementById("checkOutDate");
			const categorySelect = document.getElementById("categorySelect");
			const roomSelect = document.getElementById("roomSelect");
			const totalDisplay = document.getElementById("totalDisplay");
			const walkInForm = document.getElementById("walkInForm");
			const messageEl = document.getElementById("message");

			// Set default dates
			const today = new Date().toISOString().split("T")[0];
			checkInInput.min = today;
			checkInInput.value = today;

			const tomorrow = new Date(Date.now() + 86400000).toISOString().split("T")[0];
			checkOutInput.min = tomorrow;
			checkOutInput.value = tomorrow;

			function showMessage(text, isError = false) {
				messageEl.textContent = text;
				messageEl.className = `mt-4 p-3 rounded-lg ${isError ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`;
				messageEl.classList.remove("hidden");
			}

			async function updateAvailability() {
				const categoryId = categorySelect.value;
				const checkIn = checkInInput.value;
				const checkOut = checkOutInput.value;

				if (!categoryId || !checkIn || !checkOut) return;

				try {
					const res = await fetch(`/api/availability?checkIn=${checkIn}&checkOut=${checkOut}&categoryId=${categoryId}`);
					const data = await res.json();

					if (data.success) {
						roomSelect.innerHTML = "";
						data.rooms.forEach(r => {
							const option = document.createElement("option");
							option.value = r.id;
							option.textContent = `Room ${r.room_number}`;
							roomSelect.appendChild(option);
						});

						if (data.rooms.length === 0) {
							roomSelect.innerHTML = '<option value="" disabled>No rooms available for these dates</option>';
						}
					}
				} catch (err) {
					console.error("Error fetching availability:", err);
				}
				updateTotal();
			}

			function updateTotal() {
				const selectedCategory = categorySelect.options[categorySelect.selectedIndex];
				const price = selectedCategory ? Number(selectedCategory.dataset.price || 0) : 0;
				const roomsCount = [...roomSelect.selectedOptions].length;
				
				const start = new Date(checkInInput.value);
				const end = new Date(checkOutInput.value);
				const nights = Math.max(1, Math.ceil((end - start) / (1000 * 60 * 60 * 24)));

				const total = price * roomsCount * (isNaN(nights) ? 0 : nights);
				totalDisplay.textContent = `Total: ₦${total.toLocaleString()}`;
				return total;
			}

			checkInInput.addEventListener("change", updateAvailability);
			checkOutInput.addEventListener("change", updateAvailability);
			categorySelect.addEventListener("change", updateAvailability);
			roomSelect.addEventListener("change", updateTotal);

			walkInForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const formData = new FormData(walkInForm);
				const data = Object.fromEntries(formData.entries());
				
				// Handle multiple select
				data.roomIds = [...roomSelect.selectedOptions].map(o => o.value);
				data.totalPrice = updateTotal();

				if (data.roomIds.length === 0) {
					showMessage("Please select at least one room.", true);
					return;
				}

				try {
					const res = await fetch("/api/admin/bookings", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(data)
					});
					const result = await res.json();

					if (result.success) {
						showMessage("Walk-in booking successful! Redirecting to dashboard...");
						setTimeout(() => window.location.href = "/admin", 2000);
					} else {
						showMessage(result.error || "Booking failed", true);
					}
				} catch (err) {
					showMessage("An error occurred. Please try again.", true);
				}
			});
		</script>
</body>

</html>
