<!DOCTYPE html>
<html lang="en">

<head>
	<%- include('partials/head'); %>
		<title>Admin | Loydon Resort</title>
		<link rel="stylesheet" href="/css/general.css" />
</head>

<body class="bg-bg">
	<%- include('partials/nav'); %>

		<div class="max-w-6xl mx-auto mt-8 px-4 mb-20">
			<h1 class="text-4xl font-bold text-hotel mb-2">Admin</h1>
			<p class="text-gray-600 mb-8">Bookings and check-in overview</p>

			<!-- Stats -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
				<div class="bg-white p-6 rounded-xl shadow-md border border-gray-200">
					<div class="text-2xl font-bold text-hotel">
						<%= stats.total %>
					</div>
					<div class="text-gray-600">Total bookings</div>
				</div>
				<div class="bg-white p-6 rounded-xl shadow-md border border-gray-200">
					<div class="text-2xl font-bold text-amber-600">
						<%= stats.pending %>
					</div>
					<div class="text-gray-600">Pending check-in</div>
				</div>
				<div class="bg-white p-6 rounded-xl shadow-md border border-gray-200">
					<div class="text-2xl font-bold text-green-600">
						<%= stats.checkedIn %>
					</div>
					<div class="text-gray-600">Checked in</div>
				</div>
			</div>

			<!-- Actions -->
			<div class="mb-6 flex flex-wrap gap-4 items-center">
				<a href="/admin/check-in" class="btn">Check-in guest</a>
				<a href="/admin/categories" class="btn bg-gray-600 hover:bg-gray-700">Room categories</a>
				<a href="/admin/rooms" class="btn bg-gray-600 hover:bg-gray-700">Rooms</a>
				<a href="/admin/amenities" class="btn bg-gray-600 hover:bg-gray-700">Amenities</a>
				<a href="/admin/settings" class="btn bg-gray-600 hover:bg-gray-700">Settings</a>
				<form method="post" action="/api/admin/logout" class="ml-auto inline">
					<button type="submit" class="btn bg-gray-500 hover:bg-gray-600">Log out</button>
				</form>
			</div>


			<!-- Bookings table -->
			<div class="bg-white rounded-xl shadow-lg overflow-hidden">
				<h2 class="text-xl font-semibold text-hotel p-6 pb-2">Recent bookings</h2>
				<div class="overflow-x-auto">
					<table class="w-full text-left">
						<thead class="bg-gray-50 border-b border-gray-200">
							<tr>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Code</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Guest</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Check-in</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Check-out</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Rooms</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Total</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Status</th>
								<th class="px-6 py-3 text-sm font-semibold text-gray-700">Action</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-200">
							<% if (bookings.length===0) { %>
								<tr>
									<td colspan="8" class="px-6 py-8 text-center text-gray-500">No bookings yet.</td>
								</tr>
								<% } else { %>
									<% bookings.forEach(function(b) { %>
										<tr class="hover:bg-gray-50">
											<td class="px-6 py-4 font-mono font-semibold text-hotel">
												<%= b.booking_code %>
											</td>
											<td class="px-6 py-4">
												<div>
													<%= b.guest_name %>
												</div>
												<div class="text-sm text-gray-500">
													<%= b.guest_email %>
												</div>
											</td>
											<td class="px-6 py-4 text-gray-700">
												<%= new Date(b.check_in_date).toLocaleDateString('en-US') %>
											</td>
											<td class="px-6 py-4 text-gray-700">
												<%= new Date(b.check_out_date).toLocaleDateString('en-US') %>
											</td>
											<td class="px-6 py-4 text-gray-700">
												<% (b.room_details || []).forEach(function(r, i) { %>
													<%= r.roomNumber %>
														<%= r.roomCategory ? ' (' + r.roomCategory + ')' : '' %>
															<%= i < (b.room_details || []).length - 1 ? ', ' : '' %>
																<% }); %>
											</td>
											<td class="px-6 py-4 font-semibold text-gray-800">₦<%=
													Number(b.total_price).toLocaleString() %>
											</td>
											<td class="px-6 py-4">
												<% if (b.check_in_status==='checked_in' ) { %>
													<span
														class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">Checked
														in</span>
													<% } else { %>
														<span
															class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">Pending</span>
														<% } %>
											</td>
											<td class="px-6 py-4">
												<a href="/check-in"
													class="text-hotel hover:underline font-medium">Check-in</a>
											</td>
										</tr>
										<% }); %>
											<% } %>
						</tbody>
					</table>
				</div>
				<div
					class="flex justify-center mt-4 items-center gap-4 text-lg text-white p-2 rounded-lg bg-gray-500 hover:bg-gray-600">
					<% if (pageCount> 1) { %>
						<a href="/admin?page=<%= pageCount - 1 %>"
							class="flex justify-center mt-4 items-center gap-4 text-lg text-white p-2 rounded-lg bg-gray-500 hover:bg-gray-600">Previous</a>
						<% } %>
							<span
								class="text-gray-500 font-semibold text-lg text-white w-fit p-2 rounded-lg bg-gray-500 hover:bg-gray-600">
								<%= pageCount %>
							</span>
							<% if (bookings.length===limit) { %>
								<a href="/admin?page=<%= pageCount + 1 %>"
									class="flex justify-center mt-4 items-center gap-4 text-lg text-white p-2 rounded-lg bg-gray-500 hover:bg-gray-600">Next</a>
								<% } %>
				</div>
			</div>
		</div>

		<%- include('partials/footer'); %>
</body>

</html>