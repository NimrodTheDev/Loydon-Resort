<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('partials/head'); %>
		<title>Admin Login | Loydon Resort</title>
		<link rel="stylesheet" href="/css/general.css" />
	</head>
	<body class="bg-bg">
		<%- include('partials/nav'); %>

		<div class="max-w-md mx-auto mt-16 px-4">
			<div class="bg-white p-8 rounded-xl shadow-lg">
				<h1 class="text-2xl font-bold text-hotel mb-2">Admin login</h1>
				<p class="text-gray-600 mb-6">Sign in to manage bookings, rooms, and categories.</p>

				<% if (typeof error === 'string' && error) { %>
				<div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
					<%= error %>
				</div>
				<% } %>

				<form method="post" action="/api/admin/login" class="space-y-4">
					<div>
						<label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
						<input type="text" id="username" name="username" required autocomplete="username" class="w-full border border-gray-300 rounded-lg p-2" placeholder="admin" />
					</div>
					<div>
						<label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
						<input type="password" id="password" name="password" required autocomplete="current-password" class="w-full border border-gray-300 rounded-lg p-2" placeholder="••••••••" />
					</div>
					<button type="submit" class="btn w-full">Sign in</button>
				</form>
			</div>
		</div>

		<%- include('partials/footer'); %>
	</body>
</html>
