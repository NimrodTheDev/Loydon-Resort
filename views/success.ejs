<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('partials/head'); %>
		<title>Booking Successful | HotelExpress</title>
		<link rel="stylesheet" href="/css/general.css" />
	</head>
	<body class="bg-bg">
		<%- include('partials/nav'); %>

		<div class="max-w-2xl mx-auto mt-12 px-4 mb-20">
			<div class="bg-white p-8 rounded-xl shadow-lg text-center">
				<!-- Success Icon -->
				<div class="mb-6">
					<svg
						class="mx-auto h-24 w-24 text-green-500"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
						></path>
					</svg>
				</div>

				<h1 class="text-4xl font-bold text-hotel mb-4">
					Payment Successful! 🎉
				</h1>

				<p class="text-lg text-gray-700 mb-8">
					Thank you for your booking! Your reservation has been confirmed.
				</p>

				<!-- Payment Details -->
				<% if (payment) { %>
				<div class="bg-gray-50 p-6 rounded-lg mb-8 text-left">
					<h2 class="text-xl font-semibold text-hotel mb-4">
						Payment Details
					</h2>
					<div class="space-y-2">
						<div class="flex justify-between">
							<span class="text-gray-600">Transaction Reference:</span>
							<span class="font-semibold text-gray-800"
								><%= payment.transactionReference || 'N/A' %></span
							>
						</div>
						<% if (payment.amountPaid) { %>
						<div class="flex justify-between">
							<span class="text-gray-600">Amount Paid:</span>
							<span class="font-semibold text-gray-800"
								>₦<%= payment.amountPaid.toLocaleString() %></span
							>
						</div>
						<% } %>
					</div>
				</div>
				<% } %>

				<!-- Email Notification -->
				<div class="bg-blue-50 border-l-4 border-blue-400 p-6 mb-8 text-left">
					<div class="flex items-start">
						<div class="flex-shrink-0">
							<svg
								class="h-6 w-6 text-blue-400"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
								></path>
							</svg>
						</div>
						<div class="ml-3">
							<h3 class="text-lg font-semibold text-blue-800 mb-2">
								Check Your Email
							</h3>
							<p class="text-blue-700">
								A confirmation email has been sent to your email address with
								your <strong>booking code</strong> and all the details of your
								reservation. Please check your inbox (and spam folder) to receive
								your booking confirmation.
							</p>
							<p class="text-blue-700 mt-2">
								<strong>Important:</strong> Keep your booking code safe! You will
								need it when you check in at the hotel.
							</p>
						</div>
					</div>
				</div>

				<!-- Next Steps -->
				<div class="bg-gray-50 p-6 rounded-lg mb-8 text-left">
					<h2 class="text-xl font-semibold text-hotel mb-4">What's Next?</h2>
					<ul class="space-y-2 text-gray-700">
						<li class="flex items-start">
							<span class="text-green-500 mr-2">✓</span>
							<span
								>Check your email for the booking confirmation and your unique
								booking code</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-2">✓</span>
							<span>Arrive at the hotel on your check-in date</span>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-2">✓</span>
							<span>Present your booking code at check-in</span>
						</li>
					</ul>
				</div>

				<!-- Back to Home Button -->
				<a href="/" class="btn inline-block">
					Return to Home
				</a>
			</div>
		</div>

		<%- include('partials/footer'); %>
	</body>
</html>
