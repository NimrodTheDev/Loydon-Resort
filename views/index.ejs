<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('partials/head'); %>
		<link rel="stylesheet" href="/css/index.css" />
		<title>Loydon Resort</title>
		<meta
			name="description"
			content="Loydon Resort is a hotel in Owerri, After world bank last round about - Umuguma - Umunyayi, Come to loydon resort and enjoy hospitality at it's best."
		/>
	</head>
	<body class="bg-bg">
		<%- include('partials/nav'); %>
  <main>
        <!-- Hero Section -->
        <section class="hero container">
            <div class="hero-content">
                <h1>Welcome<br>to Loydon Resort</h1>
                <a href="https://wa.me/2348037144808?text=Goodday, I would like to make a booking at Loydon Resort" target="_blank" class="btn">Book Now</a>
            </div>
            <div class="hero-image">
                <svg viewBox="0 0 400 350" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Cloud -->
                    <ellipse cx="315" cy="65" rx="45" ry="15" fill="#c4b5a0"/>
                    
                    <!-- Building -->
                    <rect x="155" y="100" width="190" height="200" fill="#d4c4b0" stroke="#4a4238" stroke-width="3"/>
                    
                    <!-- Roof -->
                    <rect x="155" y="90" width="190" height="15" fill="#c4b5a0" stroke="#4a4238" stroke-width="3"/>
                    
                    <!-- Windows -->
                    <rect x="180" y="120" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    <rect x="235" y="120" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    <rect x="290" y="120" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    
                    <rect x="180" y="170" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    <rect x="235" y="170" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    <rect x="290" y="170" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    
                    <rect x="180" y="220" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    <rect x="235" y="220" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    <rect x="290" y="220" width="30" height="25" fill="#b4a495" stroke="#4a4238" stroke-width="2"/>
                    
                    <!-- Door -->
                    <rect x="225" y="255" width="50" height="45" rx="25" rx="25" fill="#b4a495" stroke="#4a4238" stroke-width="3"/>
                    
                    <!-- Trees -->
                    <circle cx="120" cy="280" r="35" fill="#c4b5a0"/>
                    <rect x="115" y="280" width="10" height="40" fill="#8a7d6f"/>
                    
                    <circle cx="380" cy="280" r="35" fill="#c4b5a0"/>
                    <rect x="375" y="280" width="10" height="40" fill="#8a7d6f"/>
                </svg>
            </div>
        </section>

        <!-- Rooms Section -->
        <section class="rooms-section container">
            <h2>Rooms</h2>
            <div class="rooms-grid">
                <% rooms.forEach(room => { %>
                    <div class="room-card">
                        <div class="room-icon">
                            <%- room.icon %>
                        </div>
                        <h3><a href="/rooms/<%= room.name %>"><%= room.name %></a></h3>
                    </div>
                <% }); %>
            </div>
        </section>

        <!-- Restaurant Section -->
        <section class="restaurant-section container">
            <h2>Restaurant</h2>
            <div class="restaurant-content">
                <div class="restaurant-text">
                    <p>We offer a variety of delicious dishes prepared by our experienced chef.</p>
                    <a href="#" class="btn">View Menu</a>
                </div>
                <div class="restaurant-icon">
                    <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Plate -->
                        <circle cx="100" cy="100" r="70" fill="#d4c4b0" stroke="#4a4238" stroke-width="3"/>
                        <circle cx="100" cy="100" r="55" fill="none" stroke="#4a4238" stroke-width="2"/>
                        
                        <!-- Cloche -->
                        <path d="M 70 80 Q 100 50 130 80" fill="none" stroke="#4a4238" stroke-width="3"/>
                        <ellipse cx="100" cy="80" rx="30" ry="8" fill="#c4b5a0" stroke="#4a4238" stroke-width="2"/>
                        <rect x="95" y="60" width="10" height="15" rx="5" fill="#c4b5a0" stroke="#4a4238" stroke-width="2"/>
                        
                        <!-- Fork -->
                        <line x1="30" y1="50" x2="30" y2="150" stroke="#4a4238" stroke-width="3"/>
                        <line x1="23" y1="50" x2="23" y2="80" stroke="#4a4238" stroke-width="2"/>
                        <line x1="30" y1="50" x2="30" y2="80" stroke="#4a4238" stroke-width="2"/>
                        <line x1="37" y1="50" x2="37" y2="80" stroke="#4a4238" stroke-width="2"/>
                        
                        <!-- Knife -->
                        <line x1="170" y1="50" x2="170" y2="150" stroke="#4a4238" stroke-width="3"/>
                        <path d="M 165 50 L 175 50 L 172 80 L 168 80 Z" fill="#4a4238"/>
                    </svg>
                </div>
            </div>
        </section>
    </main>
</body>

		<%- include('partials/footer'); %>
	</body>
</html>
