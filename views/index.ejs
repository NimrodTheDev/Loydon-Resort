<!DOCTYPE html>
<html lang="en">

<head>
	<%- include('partials/head'); %>
		<link rel="stylesheet" href="/css/index.css" />
		<title>Loydon Resort</title>
		<meta name="description"
			content="Hospitality isn't just a service, It's an emotional system. Let us be your emotional system for an affordable price." />
</head>

<body class="bg-bg">
	<%- include('partials/nav'); %>
		<main>
			<!-- Hero Section -->
			<section class="hero container">
				<div class="hero-content">
					<p class="hero-kicker">Loydon Resort • Owerri</p>
					<h1>
						Luxury hotel in the<br />
						heart of the city
					</h1>
					<p class="hero-subtitle">
						Loydon Resort is a modern hotel in Umuguma, Owerri, Imo State,
						Nigeria&mdash;just after Orieukwu market and before Ara Secondary
						School, Okuku. Enjoy quiet, air‑conditioned rooms, reliable Wi‑Fi,
						secure parking and friendly staff a short drive from Owerri city
						center.
					</p>
				</div>

				<div class="hero-image">
					<div class="hero-image-card">
						<img src="/asset/images/hero.jpg" alt="Front view of Loydon Resort" class="hero-placeholder" />
						<div class="hero-image-overlay">
							<p class="hero-image-title">Standard room</p>
							<p class="hero-image-meta">Comfortable, quiet and fully air‑conditioned</p>
						</div>
					</div>
				</div>

				<div class="hero-bottom">
					<div class="hero-actions">
						<a href="https://wa.me/2348037144808?text=Goodday, I would like to make a booking at Loydon Resort"
							target="_blank" class="btn">Book now</a>
						<a href="/rooms" class="btn btn-secondary">View rooms</a>
					</div>

					<div class="hero-metrics">
						<div class="metric">
							<div class="metric-value">4.9/5</div>
							<div class="metric-label">Guest rating</div>
						</div>
						<div class="metric">
							<div class="metric-value">24/7</div>
							<div class="metric-label">Concierge support</div>
						</div>
						<div class="metric">
							<div class="metric-value">15+</div>
							<div class="metric-label">Modern rooms &amp; suites</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Highlights -->
			<section class="highlights container">
				<div class="highlight">
					<h3>Located in Umuguma, Owerri</h3>
					<p>
						After Orieukwu market, close to Umuguma Police Station — before Ara Secondary School, Okuku.
					</p>
				</div>
				<div class="highlight">
					<h3>Modern, cozy &amp; comfortable</h3>
					<p>
						Thoughtfully furnished rooms with quality bedding and soft lighting.
					</p>
				</div>
				<div class="highlight">
					<h3>Friendly, warm hospitality</h3>
					<p>
						A team that knows the city and is always ready to help you settle in.
					</p>
				</div>
				<div class="highlight">
					<h3>Great value &amp; flexible stays</h3>
					<p>
						Fair pricing for both short and extended stays, with simple booking.
					</p>
				</div>
			</section>

			<!-- Rooms Section -->
			<section class="rooms-section container">
				<div class="section-header">
					<div>
						<p class="section-kicker">Rooms &amp; suites</p>
						<h2>Room and suite collection</h2>
						<p class="section-subtitle">
							Choose from our carefully curated categories, each designed for a
							different style of stay.
						</p>
					</div>
					<a href="/rooms" class="section-link">View all rooms</a>
				</div>

				<div class="rooms-grid">
					<% rooms.forEach(room=> { %>
						<% const categoryImage=room.icon && !room.icon.trim().startsWith('<svg') ? room.icon
							: '/asset/images/elementor-placeholder-image.png' ; %>
							<div class="room-card">
								<div class="room-image">
									<img src="<%= categoryImage %>" alt="<%= room.name %>" class="hero-placeholder" />
								</div>
								<div class="room-body">
									<h3>
										<a href="/rooms/<%= room.name %>">
											<%= room.name %>
										</a>
									</h3>
									<p class="room-description">
										<%= room.short_description %>
									</p>
									<div class="room-footer">
										<div class="room-price">
											<span class="room-price-label">From</span>
											<span class="room-price-value">₦<%= room.price.toLocaleString() %></span>
											<span class="room-price-label">/ night</span>
										</div>
										<a href="/rooms/<%= room.name %>" class="btn btn-ghost">View room</a>
									</div>
								</div>
							</div>
							<% }); %>
				</div>
			</section>

			<!-- Facilities & amenities -->
			<section class="amenities-section container">
				<div class="section-header">
					<div>
						<p class="section-kicker">Facilities &amp; amenities</p>
						<h2>Everything you need for a relaxed stay</h2>
					</div>
				</div>
				<div class="amenities-grid">
					<div class="amenity-card mt-[10px]">
						<h3>High‑speed Wi‑Fi</h3>
						<p>Stay connected with reliable Wi‑Fi in all rooms and public areas.</p>
					</div>
					<div class="amenity-card mt-[40px]">
						<h3>Restaurant &amp; bar</h3>
						<p>Enjoy freshly prepared meals, snacks and drinks throughout the day.</p>
					</div>
					<div class="amenity-card mt-[60px]">
						<h3>Secure parking</h3>
						<p>On‑site parking with controlled access for your peace of mind.</p>
					</div>
					<div class="amenity-card mt-[80px]">
						<h3>24/7 front desk</h3>
						<p>Late arrivals, early departures – we’re here whenever you need us.</p>
					</div>
				</div>
			</section>

			<!-- Explore hotel -->
			<section class="explore-section" id="exploreSection">
				<div class="explore-overlay">
					<div class="container explore-inner">
						<div>
							<p class="section-kicker text-light">Hotel video</p>
							<h2>Explore Loydon Resort</h2>
							<p class="explore-text" id="exploreCaption"></p>
						</div>
						<a href="#" class="explore-play" aria-label="Watch hotel video (coming soon)">
							<span class="explore-play-icon">▶</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<%- include('partials/footer'); %>

			<script>
				//Make elements have progressive margin top
				try {
					let ammeditiesCard = document.getElementsByClassName("amenity-card");

					ammeditiesCard.forEach((card, index) => {
						console.log(card);
						card.classList.add(`${index * 20}px`);
					});
				} catch (error) {
					console.log(error);
				}


				// Simple background slideshow for "Hotel video" section
				(function () {
					const exploreSection = document.getElementById("exploreSection");
					const exploreCaption = document.getElementById("exploreCaption");
					if (!exploreSection) return;

					const images = [
						"/asset/images/hero.jpg",
						"/asset/images/barside.jpg",
						"/asset/images/food.jpg",
						"/asset/images/Beer.jpeg",
						"/asset/images/spice.jpg",
					];
					const captions = [
						"", // hero image - no extra detail text
						"Relax at our outdoor bar side with cold drinks, music and space to unwind with friends.",
						"Taste our delicious meals and local delicacies, freshly prepared daily.",
						"Enjoy ice-cold beer and chilled drinks at our bar — perfect for winding down.",
						"Try our spicy delicacies — perfectly seasoned and served hot.",
					];

					let current = 0;

					function setBackground(index) {
						exploreSection.style.backgroundImage = `url('${images[index]}')`;
						if (exploreCaption) exploreCaption.textContent = captions[index] || "";
					}

					setBackground(current);

					setInterval(() => {
						current = (current + 1) % images.length;
						setBackground(current);
					}, 6000);
				})();
			</script>
</body>

</html>