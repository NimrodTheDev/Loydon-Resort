<script>
    // public/asset/script/componentCreator.ts
    console.log("componentCreator.ts");
    window.elementCreator({
        name: "password-comp",
        atr: [],
        pugFunc: settingCompHtml,
        func: [
            {
                event: "click",
                callback: (e) => {
                    const target = e.target;
                    if (target && target.tagName === "BUTTON" && target.getAttribute("type") === "button") {
                        const formElement = target.closest("form");
                        if (formElement) {
                            const formData = {
                                password: formElement.querySelector('input[name="currentPassword"]')?.value,
                                newPassword: formElement.querySelector('input[name="newPassword"]')?.value,

                            };
                            toggleLoading(target, true);
                            fetch("/api/password", {
                                method: "PUT",
                                headers: {
                                    "Content-Type": "application/json",
                                },
                                body: JSON.stringify({
                                    ...formData,
                                }),
                            })
                                .then((response) => response.json())
                                .then((data) => {
                                    if (data.success) {
                                        showToast("Password updated successfully!");
                                    } else {
                                        showToast(data.error || "Failed to update password", "error");
                                    }
                                })
                                .catch((error) => {
                                    console.error("Error saving settings:", error);
                                    showToast("Failed to update password", "error");
                                })
                                .finally(() => {
                                    toggleLoading(target, false);
                                });
                        }
                    } else if (target.getAttribute("type") === "button") {

                    }
                }
            }
        ]
    });
    // public/asset/script/settingCompHtml.ts
    function settingCompHtml({ prop }) {
        return `
    <form action="#" method="POST" class="p-6 space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
                            <input type="password" name="currentPassword"
                                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 outline-none transition-all"
                                placeholder="••••••••" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
                            <input type="password" name="newPassword"
                                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 outline-none transition-all"
                                placeholder="••••••••" />
                        </div>
                    </div>
                    <div class="flex justify-end pt-2">
                        <button type="button"
                            class="px-5 py-2.5 bg-gray-800 text-white hover:bg-gray-900 rounded-lg font-medium shadow-sm transition-all">Update
                            Password</button>
                    </div>
                </form>
    `;
    }

</script>