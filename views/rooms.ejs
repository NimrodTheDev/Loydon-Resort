<!DOCTYPE html>
<html lang="en">
	<head>
		<link rel="stylesheet" href="/css/rooms.css" />
		<%- include('partials/head'); %>
		<title>Rooms</title>
	</head>
	<body class="bg-bg">
		<%- include('partials/nav'); %>

		<div class="max-w-6xl mx-auto px-4 mt-12">
			<h1 class="text-3xl font-bold text-hotel mb-8">Our Rooms</h1>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
				<% rooms.forEach(room => { %>
				<div class="room-card">
					<%- room.icon %>

					<div class="p-5">
						<h3 class="text-xl font-semibold text-hotel mb-2">
							<%= room.name %>
						</h3>

						<p class="text-gray-600 mb-3"><%= room.short_description %></p>

						<p class="text-lg font-semibold text-accent mb-4">
							₦<%= room.price %> / night
						</p>

						<a href="/rooms/<%= room.name %>" class="btn"> View Details </a>
					</div>
				</div>
				<% }) %>
			</div>
		</div>

		<%- include('partials/footer'); %>
	</body>
</html>
