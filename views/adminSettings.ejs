<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head'); %>
        <title>Settings | Admin | Loydon Resort</title>
        <link rel="stylesheet" href="/css/general.css" />
</head>

<body class="bg-bg">
    <%- include('partials/nav'); %>

        <div class="max-w-4xl mx-auto mt-8 px-4 mb-20">
            <!-- Breadcrumb or Header -->
            <div class="flex items-center gap-4 mb-6">
                <a href="/admin" class="text-gray-500 hover:text-hotel transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                </a>
                <h1 class="text-3xl font-bold text-hotel">Hotel Settings</h1>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 p-6 border-b border-gray-200">
                    <h2 class="text-xl font-semibold text-gray-800">General Information</h2>
                    <p class="text-sm text-gray-500 mt-1">Update the contact and basic information displayed to
                        customers on the website.</p>
                </div>
                <%- include('components/settingComp', hotelInfo); %>
                    <setting-comp-two hotelname="<%= hotelInfo.name %>" email="<%= hotelInfo.email %>"
                        phone="<%= hotelInfo.phone %>" websiteurl="<%= hotelInfo.website %>"
                        street="<%= hotelInfo.street %>" city="<%= hotelInfo.city %>" state="<%= hotelInfo.state %>"
                        landmarks="<%= hotelInfo.nearbyLandmarks ? hotelInfo.nearbyLandmarks.join(', ') : '' %>"></setting-comp-two>
            </div>

            <!-- Security Section -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mt-8">
                <div class="bg-gray-50 p-6 border-b border-gray-200">
                    <h2 class="text-xl font-semibold text-gray-800">Security & Authentication</h2>
                    <p class="text-sm text-gray-500 mt-1">Manage admin access password and security preferences.</p>
                </div>
                <form action="#" method="POST" class="p-6 space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
                            <input type="password" name="currentPassword"
                                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 outline-none transition-all"
                                placeholder="••••••••" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
                            <input type="password" name="newPassword"
                                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-gray-800 focus:border-gray-800 outline-none transition-all"
                                placeholder="••••••••" />
                        </div>
                    </div>
                    <div class="flex justify-end pt-2">
                        <button type="button"
                            class="px-5 py-2.5 bg-gray-800 text-white hover:bg-gray-900 rounded-lg font-medium shadow-sm transition-all">Update
                            Password</button>
                    </div>
                </form>
            </div>
        </div>

        <%- include('partials/footer'); %>
</body>

</html>