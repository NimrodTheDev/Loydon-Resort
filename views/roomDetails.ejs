<!DOCTYPE html>
<html lang="en">
	<head>
		<%- include('partials/head'); %>
		<title><%= room.name %> | Details</title>
	</head>

	<body class="bg-bg">
		<%- include('partials/nav'); %>

		<div class="max-w-6xl mx-auto px-4 mt-14 mb-20">
			<!-- Room Details Section -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
				<!-- Room Image/Icon -->
				<div class="w-full">
					<div class="overflow-hidden rounded-2xl shadow-2xl">
						<% const categoryImage = room.icon && !room.icon.trim().startsWith('<svg') ? room.icon : '/asset/images/elementor-placeholder-image.png'; %>
						<img
							src="<%= categoryImage %>"
							alt="<%= room.name %>"
							class="hero-placeholder w-full"
						/>
					</div>
				</div>

				<!-- Room Info -->
				<div>
					<p class="uppercase tracking-[0.16em] text-sm text-[#9b8b77] mb-2">
						Room category
					</p>
					<h1 class="text-4xl font-bold text-hotel mb-4"><%= room.name %></h1>

					<p class="text-lg text-gray-700 mb-6">
						<%= room.short_description %>
					</p>

					<p class="text-2xl font-semibold text-accent mb-6">
						₦<%= room.price.toLocaleString() %> / night
					</p>

					<a
						href="/book/<%= room.name.toLowerCase().replace(/\s+/g, '-') %>"
						class="btn"
						>Book Now</a
					>
				</div>
			</div>

			<!-- Amenities -->
			<% if (room.amenities && room.amenities.length > 0) { %>
			<div class="mt-16">
				<h2 class="text-2xl font-bold text-hotel mb-4">Amenities</h2>

				<ul class="grid grid-cols-2 md:grid-cols-3 gap-4">
					<% room.amenities.forEach(a => { %>
					<li class="bg-white shadow p-4 rounded-lg text-gray-700"><%= a %></li>
					<% }) %>
				</ul>
			</div>
			<% } %>

			<!-- Available Room Numbers -->
			<% if (room.available && room.available.length > 0) { %>
			<div class="mt-16">
				<h2 class="text-2xl font-bold text-hotel mb-4">Available Rooms</h2>

				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					<% room.available.forEach(num => { %>
					<div class="bg-white shadow p-4 rounded-lg text-center text-gray-700">
						Room <span class="font-semibold text-hotel"><%= num %></span>
					</div>
					<% }) %>
				</div>
			</div>
			<% } %>
		</div>

		<%- include('partials/footer'); %>
	</body>
</html>
